{
  "name": "ez-devbox",
  "version": "0.6.3",
  "description": "Launch and reconnect disposable E2B sandboxes for coding-agent workflows",
  "main": "dist/src/cli/index.js",
  "types": "dist/src/cli/index.d.ts",
  "bin": {
    "ez-devbox": "dist/src/cli/index.js",
    "ezdb": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "docs/*.md",
    "docs/assets",
    "examples",
    "scripts/ws-ssh-proxy.mjs",
    ".env.example",
    "ez-devbox.config.toml",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsgo -p tsconfig.build.json && node -e \"const fs = require('node:fs'); fs.chmodSync('dist/src/cli/index.js', 0o755);\"",
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "create": "tsx src/cli/index.ts create",
    "connect": "tsx src/cli/index.ts connect",
    "resume": "tsx src/cli/index.ts resume",
    "list": "tsx src/cli/index.ts list",
    "command": "tsx src/cli/index.ts command",
    "wipe": "tsx src/cli/index.ts wipe",
    "wipe-all": "tsx src/cli/index.ts wipe-all",
    "check:complexity": "tsx scripts/check-complexity.ts",
    "lint": "biome lint src test scripts package.json",
    "format": "biome format --write src test scripts package.json",
    "check:style": "biome check src test scripts package.json",
    "validate:offline": "npm run check:complexity && npm run check:style && npm run test:coverage && npm run build && npm run pack:check",
    "validate": "npm run validate:offline && npm run e2e:live",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:live": "tsx scripts/e2e.live.ts",
    "template:build": "tsx templates/build.ts",
    "pack:check": "tsx scripts/verify-pack-dry-run.ts && tsx scripts/verify-installed-package.ts",
    "release": "tsx scripts/release.ts"
  },
  "keywords": [
    "e2b",
    "sandbox",
    "cli",
    "developer-tools",
    "coding-agents",
    "remote-development",
    "dev-environment",
    "reconnect",
    "opencode",
    "codex",
    "claude-code",
    "tmux",
    "ssh"
  ],
  "author": "Shane Bishop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shanebishop1/ez-devbox.git"
  },
  "bugs": {
    "url": "https://github.com/shanebishop1/ez-devbox/issues"
  },
  "homepage": "https://github.com/shanebishop1/ez-devbox#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "e2b": "^2.46.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
